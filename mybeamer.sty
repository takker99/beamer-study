% Helper: replay a frame without creating a new PDF destination (avoid duplicate destination warnings)
% Usage: wrap \againframe with \againframeNoDest{<label>}
\newcommand{\againframeNoDest}[1]{%
  % Save current value of \beamer@frameinlist and \beamer@againframe to avoid interfering
  % Use the internal command that prints a frame without creating a PDF destination.
  % Approach: temporarily disable the hyperlink anchor creation provided by hyperref
  \begingroup
  \let\Hy@raisedlink\relax
  \againframe{#1}%
  \endgroup
}
