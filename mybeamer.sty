% basic settings for the use of LuaLaTeX
\usepackage{luatexja-fontspec}

% Set English fonts to Times New Roman with fallbacks
\IfFontExistsTF{Times New Roman}{%
  \setmainfont[Ligatures={Rare,TeX}]{Times New Roman}
  \setsansfont{Times New Roman}
}{%
  \IfFontExistsTF{Liberation Serif}{%
    \setmainfont[Ligatures={Rare,TeX}]{Liberation Serif}
    \setsansfont{Liberation Serif}
  }{%
    \setmainfont[Ligatures={Rare,TeX}]{TeX Gyre Termes}
    \setsansfont{TeX Gyre Termes}
  }%
}

% Set Japanese fonts to MS Gothic with fallbacks
\IfFontExistsTF{MS Gothic}{%
  \setmainjfont[
    BoldFont           = MS-Gothic,
    BoldFeatures       = {FakeBold=2},
    ItalicFont         = MS-Mincho,
    ItalicFeatures     = {FakeSlant=0.33},
    BoldItalicFont     = MS-Gothic,
    BoldItalicFeatures = {FakeBold=2, FakeSlant=0.33}
  ]{MS-Mincho}
  \setsansjfont[
    BoldFont           = MS-Gothic,
    BoldFeatures       = {FakeBold=2},
    ItalicFont         = MS-Gothic,
    ItalicFeatures     = {FakeSlant=0.33},
    BoldItalicFont     = MS-Gothic,
    BoldItalicFeatures = {FakeBold=2, FakeSlant=0.33}
  ]{MS-Gothic}
}{%
  \setmainjfont{IPAGothic}
  \setsansjfont{IPAGothic}
}

