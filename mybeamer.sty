% Bibliography with biblatex
\usepackage[backend=biber,style=ieee,sorting=none]{biblatex}
\addbibresource{refs.bib}

% Track if any citations have been made
\newbool{hascitations}
\AtEveryCitekey{\global\booltrue{hascitations}}

% Custom command to print bibliography only if there are citations
\newcommand{\printbibliographyframe}{%
  \ifbool{hascitations}{%
    \begin{frame}[allowframebreaks]
      \frametitle{参考文献}
      \bibbysection[heading=none]
    \end{frame}%
  }{}%
}

