{
  "filters": {
    "comments": true
  },
  "plugins": [
    "latex2e"
  ],
  "rules": {
    "preset-ja-engineering-paper": true,
    "preset-ja-spacing": true,
    "preset-ja-technical-writing": false,
    "preset-japanese": {
      "sentence-length": false
    },
    "preset-jtf-style": {
      "1.2.1.句点(。)と読点(、)": false,
      "1.2.2.ピリオド(.)とカンマ(,)": false,
      "4.1.3.ピリオド(.)、カンマ(,)": false
    }
  }
}